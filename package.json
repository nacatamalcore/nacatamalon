{
    "name": "nacatamalon",
    "version": "0.3.1",
    "description": "A retro-first 2D and 3D game engine for the web, on WebGPU with a WebGL2 fallback, written with hooks and plain functions.",
    "license": "MIT",
    "author": "Francisco José Pereira Alvarado",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nacatamalcore/nacatamalon.git"
    },
    "homepage": "https://nacatamalon.com",
    "bugs": {
        "url": "https://github.com/nacatamalcore/nacatamalon/issues"
    },
    "keywords": [
        "game-engine",
        "gamedev",
        "retro",
        "webgpu",
        "webgl2",
        "2d",
        "3d",
        "pixel-art",
        "hooks",
        "typescript"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "llms.txt",
        "llms-full.txt",
        "guides"
    ],
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./authoring": {
            "types": "./dist/types/authoring.d.ts",
            "default": "./dist/authoring/index.js"
        },
        "./extend": {
            "types": "./dist/types/extend.d.ts",
            "default": "./dist/extend/index.js"
        },
        "./physics2d": {
            "types": "./dist/types/physics2d.d.ts",
            "default": "./dist/physics2d.js"
        },
        "./physics3d": {
            "types": "./dist/types/physics3d.d.ts",
            "default": "./dist/physics3d.js"
        },
        "./react": {
            "types": "./dist/types/react.d.ts",
            "default": "./dist/react/index.js"
        },
        "./headless": {
            "types": "./dist/types/headless.d.ts",
            "default": "./dist/headless/index.js"
        },
        "./speech": {
            "types": "./dist/types/speech.d.ts",
            "default": "./dist/speech/index.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "authoring": [
                "./dist/types/authoring/index.d.ts"
            ],
            "extend": [
                "./dist/types/extend/index.d.ts"
            ],
            "physics2d": [
                "./dist/types/physics/rapier2d/index.d.ts"
            ],
            "physics3d": [
                "./dist/types/physics/box3d/index.d.ts"
            ],
            "react": [
                "./dist/types/react/index.d.ts"
            ],
            "headless": [
                "./dist/types/headless/index.d.ts"
            ],
            "speech": [
                "./dist/types/speech/index.d.ts"
            ]
        }
    },
    "scripts": {
        "docs": "typedoc",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "build": "bun run clean && bun run build:js && bun run build:strip && bun run build:types && bun run build:llms",
        "build:js": "esbuild src/index.ts src/authoring/index.ts src/extend/index.ts src/react/index.ts src/headless/index.ts src/speech/index.ts physics2d=src/physics/rapier2d/index.ts physics3d=src/physics/box3d/index.ts --bundle --splitting --format=esm --outdir=dist --packages=external --sourcemap --log-level=warning",
        "build:strip": "bun scripts/strip_bare_imports.ts",
        "build:types": "bun scripts/build_types.ts",
        "build:llms": "bun scripts/build_llms.ts",
        "build:fonts": "bun scripts/build_fonts.ts",
        "check:package": "bun scripts/check_package.ts",
        "prepublishOnly": "bun run build && bun run check:package"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/react": "^19.2.14",
        "@webgpu/types": "^0.1.70",
        "esbuild": "^0.28.2",
        "react": "^19.2.6",
        "rollup": "^4.65.1",
        "rollup-plugin-dts": "^6.5.1",
        "typedoc": "^0.28.19",
        "typescript": "~6.0.2"
    },
    "dependencies": {
        "@dimforge/rapier2d-compat": "^0.21.0",
        "box3d.js": "^0.1.1",
        "wgpu-matrix": "^3.4.2"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
